diff --git a/turtlebot3_lime_description/webots/turtlebot3_lime.webots.xacro b/turtlebot3_lime_description/webots/turtlebot3_lime.webots.xacro
new file mode 100644
index 0000000..b6b11f5
--- /dev/null
+++ b/turtlebot3_lime_description/webots/turtlebot3_lime.webots.xacro
@@ -0,0 +1,89 @@
+<?xml version="1.0"?>
+<!--
+Webots device/plugin bindings for turtlebot3_lime, used in place of the
+<gazebo> sensor/plugin tags when running under webots_ros2_driver
+(use_webots:=true). Device "reference" names below must match the device
+names baked into the robot's PROTO by webots_ros2_importer, which in turn
+come straight from the <sensor name="..."> tags in
+gazebo/turtlebot3_bigwheel_orin.gazebo.xacro.
+-->
+<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
+
+  <xacro:macro name="turtlebot3_lime_webots_devices" params="prefix">
+    <webots>
+      <device reference="lds_lfcd_sensor" type="Lidar">
+        <ros>
+          <enabled>true</enabled>
+          <updateRate>5</updateRate>
+          <topicName>/scan</topicName>
+          <alwaysOn>false</alwaysOn>
+          <frameName>${prefix}base_scan</frameName>
+        </ros>
+      </device>
+      <!-- topicName + imageSuffix/cameraInfoSuffix are combined by webots_ros2_driver
+           (topicName + suffix) so that the published topics match the exact
+           names the old realsense_gazebo_plugin used and that lib/actor/system.py
+           subscribes to (e.g. /camera/camera/color/image_raw, without any
+           extra /image_color suffix). -->
+      <device reference="cameracolor" type="Camera">
+        <ros>
+          <enabled>true</enabled>
+          <updateRate>30</updateRate>
+          <topicName>/camera/camera/color</topicName>
+          <imageSuffix>/image_raw</imageSuffix>
+          <cameraInfoSuffix>/camera_info</cameraInfoSuffix>
+          <frameName>${prefix}camera_color_optical_frame</frameName>
+        </ros>
+      </device>
+      <device reference="cameradepth" type="RangeFinder">
+        <ros>
+          <enabled>true</enabled>
+          <updateRate>30</updateRate>
+          <topicName>/camera/camera/depth</topicName>
+          <imageSuffix>/image_rect_raw</imageSuffix>
+          <cameraInfoSuffix>/camera_info</cameraInfoSuffix>
+          <frameName>${prefix}camera_depth_optical_frame</frameName>
+        </ros>
+      </device>
+      <device reference="cameraired1" type="Camera">
+        <ros>
+          <enabled>true</enabled>
+          <updateRate>30</updateRate>
+          <topicName>/camera/camera/infra1</topicName>
+          <imageSuffix>/image_rect_raw</imageSuffix>
+          <cameraInfoSuffix>/camera_info</cameraInfoSuffix>
+          <frameName>${prefix}camera_infra1_optical_frame</frameName>
+        </ros>
+      </device>
+      <device reference="cameraired2" type="Camera">
+        <ros>
+          <enabled>true</enabled>
+          <updateRate>30</updateRate>
+          <topicName>/camera/camera/infra2</topicName>
+          <imageSuffix>/image_rect_raw</imageSuffix>
+          <cameraInfoSuffix>/camera_info</cameraInfoSuffix>
+          <frameName>${prefix}camera_infra2_optical_frame</frameName>
+        </ros>
+      </device>
+      <device reference="gps" type="GPS">
+        <ros>
+          <enabled>true</enabled>
+          <updateRate>10</updateRate>
+          <topicName>/gps</topicName>
+          <frameName>${prefix}imu_link</frameName>
+        </ros>
+      </device>
+      <plugin type="webots_ros2_driver::Ros2IMU">
+        <alwaysOn>true</alwaysOn>
+        <updateRate>100</updateRate>
+        <topicName>/imu</topicName>
+        <frameName>${prefix}imu_link</frameName>
+        <inertialUnitName>inertial_unit</inertialUnitName>
+        <gyroName>gyro</gyroName>
+        <accelerometerName>accelerometer</accelerometerName>
+      </plugin>
+      <plugin type="webots_ros2_control::Ros2Control" />
+    </webots>
+  </xacro:macro>
+
+</robot>
