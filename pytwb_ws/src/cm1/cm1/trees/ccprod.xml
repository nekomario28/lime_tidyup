<root>
    <BehaviorTree ID="cube_floor_1m_grasp">
        <!--
            Production-shaped sequence: the cube lies on the floor about 1 m
            ahead, the robot drives in until the arm can reach it, then grasps
            with a fixed arm posture. No pose_3d and no navigation destinations,
            matching practice_ws/trees/ccc.xml which uses use_pose_3d="[0]".
        -->
        <Sequence name="main">
            <SearchCube name="search_cube" threshold="[0.30]"/>
            <TakeAim name="take_aim_far" threshold="[0.30]"
                     turn_speed="[0.20]" center_tolerance="[15.0]"/>
            <GoFrontCube name="approach" threshold="[0.30]"
                         stop_distance="[0.30]" forward_speed="[0.15]"
                         turn_speed="[0.20]" target_offset_px="[40]"
                         use_pose_3d="[0]" depth_sample_count="[1]"
                         depth_roi_fraction="[0.35]" depth_minimum_valid_ratio="[0.50]"
                         depth_maximum_mad_m="[0.03]" depth_maximum_spread_m="[0.04]"
                         cube_side_length_m="[0.057]"
                         geometry_minimum_scale="[0.40]" geometry_maximum_scale="[2.50]"
                         temporal_window_size="[5]" temporal_required_count="[3]"
                         temporal_center_distance_px="[60]"/>
            <TakeAim name="take_aim_near" threshold="[0.30]"
                     turn_speed="[0.10]" center_tolerance="[10.0]"/>
            <Open name="open_gripper"/>
            <Hirou_Pose name="hirou_pose"/>
            <Walk name="walk_forward_15cm" distance="[0.15]"/>
            <Close name="close_gripper"/>
            <Sleep name="settle" time="[2.0]"/>
        </Sequence>
    </BehaviorTree>
</root>
