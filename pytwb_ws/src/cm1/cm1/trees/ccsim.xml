<root>
    <BehaviorTree ID="cube_search_grasp">
        <!--
            Sim variant of ccc.xml with no map-relative navigation: the robot is
            spawned in an empty world with the cube already in front of it, so
            SearchCube / TakeAim / GoFrontCube do the searching and approaching,
            ArmToCube aims the arm at the model-free pose, and Close grasps.
            Nav2 is launched as part of the stack but this tree issues no
            navigation goal, because the destinations in ccc.xml belong to the
            real map and would send the robot somewhere arbitrary here.
        -->
        <Sequence name="main">
            <SearchCube name="search_cube" threshold="[0.30]"/>
            <TakeAim
                name="take_aim_before_approach"
                threshold="[0.30]"
                turn_speed="[0.15]"
                center_tolerance="[12.0]"/>
            <GoFrontCube
                name="go_front_cube"
                threshold="[0.30]"
                stop_distance="[0.30]"
                forward_speed="[0.15]"
                turn_speed="[0.15]"
                target_offset_px="[40]"
                pose_max_reprojection_error_px="[1.5]"
                use_pose_3d="[0]"
                depth_sample_count="[1]"
                depth_roi_fraction="[0.35]"
                depth_minimum_valid_ratio="[0.60]"
                depth_maximum_mad_m="[0.025]"
                depth_maximum_spread_m="[0.030]"
                cube_side_length_m="[0.057]"
                geometry_minimum_scale="[0.60]"
                geometry_maximum_scale="[1.90]"
                temporal_window_size="[5]"
                temporal_required_count="[3]"
                temporal_center_distance_px="[60]"/>
            <TakeAim
                name="take_aim_after_approach"
                threshold="[0.30]"
                turn_speed="[0.10]"
                center_tolerance="[10.0]"/>
            <!-- arm aimed at the detected cube, with an explicit orientation -->
            <ArmToCube
                name="arm_to_cube"
                standoff="0.12"
                roll="180.0"
                pitch="0.0"
                yaw="0.0"
                minimum_confidence="0.30"/>
            <Open name="open_gripper"/>
            <Walk name="walk_forward_15cm" distance="[0.15]"/>
            <Close name="grab_cube"/>
            <Sleep name="wait_after_grab" time="[2.0]"/>
            <ArmHome name="arm_home"/>
        </Sequence>
    </BehaviorTree>
</root>
