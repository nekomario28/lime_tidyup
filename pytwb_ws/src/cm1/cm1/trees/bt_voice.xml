<root>
    <BehaviorTree ID="bt_voice">
        <Repeat name="voice_loop" num_success="[999]">
            <Sequence name="main">
                <Retry name="listen_retry" num_failures="[999]">
                    <Sequence name="listen_and_parse">
                        <VoiceRecognition
                            name="listen"
                            language="ja"
                            model="large"
                            device_index="-1"
                        />
                        <ProcessVoiceCommand name="process" />
                    </Sequence>
                </Retry>
                <VoiceSpeak name="confirm" text="わかりました、移動します" />
                <GoToPose name="go" />
            </Sequence>
        </Repeat>
    </BehaviorTree>
</root>
