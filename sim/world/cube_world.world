<?xml version="1.0"?>
<sdf version="1.6">
  <world name="cube_grasp">
    <!-- LinkAttacher is this project's own way of fixing a grasp in sim
         (bin/attach calls /ATTACHLINK); gazebo_grasp_fix is not built here. -->
    <plugin name="gazebo_link_attacher" filename="libgazebo_link_attacher.so"/>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <!-- Grasping is a stiff contact problem: the default 50 iterations and a
           zero-thickness contact allow a squeezed 57 mm cube to slide out. -->
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
          <contact_surface_layer>0.002</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <scene>
      <ambient>0.35 0.35 0.38 1</ambient>
      <background>0.22 0.22 0.26 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <light name="fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.45 0.45 0.45 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0.7 -0.3 -0.5</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <!-- Dark floor on purpose: a light one is the largest "white" region
               in the frame and the colour frontend picks it as a cube face
               (measured 126,995 px vs 1,965 px for the real face). -->
          <material>
            <ambient>0.18 0.18 0.20 1</ambient>
            <diffuse>0.26 0.26 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The robot camera is spawned by sim/follow_camera.py so it can follow
         base_link; a world-static camera is left behind once the robot drives. -->
    <!-- Both cameras are spawned by sim/follow_camera.py and moved with the
         robot: a world-static camera ends up inside the robot once it drives. -->
    <model name="observer_camera">
      <static>true</static>
      <!-- third person: from the side, covering spawn -> station -->
      <pose>0.45 -1.40 0.80 0 0.3556 1.5708</pose>
      <link name="link">
        <sensor name="observer" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.00</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>20.0</far></clip>
          </camera>
          <plugin name="observer_ros" filename="libgazebo_ros_camera.so">
            <ros><namespace>/observer</namespace></ros>
            <camera_name>camera</camera_name>
            <frame_name>observer_optical_frame</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
