#!/bin/bash
#   MAP             nav2 の地図 yaml              (必須: --map で指定)
#
#   OneStageROS + fake bringup (run_turtle_base 等) が起動済みの環境に追加で起動する

# ----- コマンドライン引数のパース -----
while [[ $# -gt 0 ]]; do
  case "$1" in
    --map)
      MAP="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: $0 --map MAP_FILE"
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

if [[ -z "$MAP" ]]; then
  echo "Error: --map is required"
  echo "Usage: $0 --map MAP_FILE"
  exit 1
fi

if [[ ! -f "$MAP" ]]; then
  echo "Map file not found: $MAP"
  exit 1
fi

source /opt/ros/humble/setup.bash
source ~/turtlebot3_ws/install/setup.bash

echo "=== run_navigation ==="
echo "  MAP = $MAP"
echo

# Nav2(+RViz)  wall-clock
ros2 launch turtlebot3_lime_navigation2 navigation2.launch.py map_yaml_file:="$MAP"
