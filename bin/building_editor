#!/bin/bash
if [ -d ~/practice_ws ]; then
    export BUILDING_EDITOR_OBJECTS_DIR=~/practice_ws/objects
    export BUILDING_EDITOR_EXPORT_DIR=~/practice_ws/worlds
    # 自作オブジェクト(model.sdf / *.proto のあるフォルダ)をカタログに出す。既に設定済みなら追加する
    export BUILDING_EDITOR_LOCAL_OBJECTS=${BUILDING_EDITOR_LOCAL_OBJECTS:+$BUILDING_EDITOR_LOCAL_OBJECTS:}$HOME/practice_ws/objects
fi
python3 ~/sdf_building_editor/main.py
