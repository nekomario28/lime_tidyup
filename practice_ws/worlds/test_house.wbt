#VRML_SIM R2023b utf8

# building_editor から書き出したワールド。
# SDF版(building.sdf)と同一座標になるよう coordinateSystem を ENU(Z-up) に固定している。
# 要検証: Webotsで開いて壁の位置・向きがSDF版と一致するか確認すること。
#
# 背景・床は Webots公式カタログの PROTO(TexturedBackground/Floor 等)ではなく、
# あえて組み込みノード(Background/DirectionalLight/Plane)だけで組んでいる。理由は2つ:
#   1. 無地の背景にしたい(写実的な空のPROTOは今回不要)
#   2. PROTOを使うと EXTERNPROTO 宣言が必須になり(Webots R2022b以降)、
#      かつ実行時にraw.githubusercontent.comへネットワーク接続が必要になる。
#      壁・ドアと同じく、このツールの他の部分は完結性を優先しているので合わせる。

WorldInfo {
  coordinateSystem "ENU"
  title "building_editor_world"
}
Viewpoint {
  orientation -0.3 0.3 0.9 1.7
  position -5 -5 8
}
Background {
  skyColor [ 0.6 0.6 0.6 ]
}
DirectionalLight {
  direction 0.3 -0.5 -0.6
  intensity 1.5
}
Solid {
  name "floor"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.85
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 21 21
      }
    }
  ]
  boundingObject Plane {
    size 21 21
  }
}
  Solid {
    translation -0.4000 2.2100 0.5000
    rotation 0 0 1 0.127564
    name "wall_0"
    children [
      Shape {
        appearance PBRAppearance {
          baseColor 0.8 0.8 0.8
          roughness 1
          metalness 0
        }
        geometry Box {
          size 9.2754 0.1000 1.0000
        }
      }
    ]
    boundingObject Box {
      size 9.2754 0.1000 1.0000
    }
  }
  Solid {
    translation 4.6100 -0.0400 0.5000
    rotation 0 0 1 -1.427421
    name "wall_1"
    children [
      Shape {
        appearance PBRAppearance {
          baseColor 0.8 0.8 0.8
          roughness 1
          metalness 0
        }
        geometry Box {
          size 5.7389 0.1000 1.0000
        }
      }
    ]
    boundingObject Box {
      size 5.7389 0.1000 1.0000
    }
  }
  Solid {
    translation 0.6400 -2.6700 0.5000
    rotation 0 0 1 3.093684
    name "wall_2"
    children [
      Shape {
        appearance PBRAppearance {
          baseColor 0.8 0.8 0.8
          roughness 1
          metalness 0
        }
        geometry Box {
          size 8.7701 0.1000 1.0000
        }
      }
    ]
    boundingObject Box {
      size 8.7701 0.1000 1.0000
    }
  }
  Solid {
    translation -4.3700 -0.4200 0.5000
    rotation 0 0 1 1.870328
    name "wall_3"
    children [
      Shape {
        appearance PBRAppearance {
          baseColor 0.8 0.8 0.8
          roughness 1
          metalness 0
        }
        geometry Box {
          size 4.2701 0.1000 1.0000
        }
      }
    ]
    boundingObject Box {
      size 4.2701 0.1000 1.0000
    }
  }

  Solid {
    translation -3.2787 0.8144 0.0000
    rotation 0 0 1 -0.103291
    name "obj_0_AirportBench"
    children [
      Transform {
        scale 1 1 1
        children [
          Shape {
        appearance PBRAppearance {
          baseColorMap ImageTexture {
            url [ "/root/practice_ws/objects/OpenRobotics_AirportBench/meshes/AirportBench_Diffuse.png" ]
          }
          roughness 1
          metalness 0
        }
            geometry Mesh {
              url [ "/root/practice_ws/objects/OpenRobotics_AirportBench/meshes/AirportBench.obj" ]
            }
          }
        ]
      }
    ]
    boundingObject Box {
      size 0.4 0.4 0.4
    }
  }
  Solid {
    translation 3.8800 -0.3800 0.6097
    rotation 0 0 1 -3.019420
    name "obj_1_AirportSign4"
    children [
      Transform {
        scale 1 1 1
        children [
          Shape {
        appearance PBRAppearance {
          baseColorMap ImageTexture {
            url [ "/root/practice_ws/objects/OpenRobotics_AirportSign4/meshes/AirportSign4_Diffuse.png" ]
          }
          roughness 1
          metalness 0
        }
            geometry Mesh {
              url [ "/root/practice_ws/objects/OpenRobotics_AirportSign4/meshes/AirportSign4.obj" ]
            }
          }
        ]
      }
    ]
    boundingObject Box {
      size 0.4 0.4 0.4
    }
  }
