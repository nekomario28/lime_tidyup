<root>
    <BehaviorTree ID="cube_grab">
        <Sequence name="main">
            
            <!-- 0. 位置指定 -->

            <SetDestinationByName name="set_init" destination="C"/>
            <GoToPose name="go" />

            <!-- 1. キューブを探す -->
            <SearchCube
                name="search_cube"
                threshold="[0.01]"/>

            <!-- 2. キューブを画像中央に合わせる -->
            <TakeAim
                name="take_aim_before_approach"
                threshold="[0.20]"
                turn_speed="[0.30]"
                center_tolerance="[20.0]"/>

            <Mini_Walk name="walk_backward"
                target="[-400]"/>

            <!-- 3. Depthで距離を測り、キューブの手前まで進む -->
            <GoFrontCube
                name="go_front_cube"
                threshold="[0.2]"
                stop_distance="[0.30]"
                forward_speed="[0.5]"
                turn_speed="[0.30]"
                target_offset_px="[40]"/>
            <!-- 4. 接近後、もう一度キューブを中央に合わせる -->
            <!-- <TakeAim
                name="take_aim_after_approach"
                threshold="[0.30]"
                turn_speed="[0.30]"
                center_tolerance="[20.0]"/> -->
  
            <!-- 5. アームを物をつかむ姿勢にする -->
            <Open name="hirou"/>  
            <Hirou_Pose name="hirou_pose"/>

            <!-- 6. その姿勢のまま40cm前進する -->
            <Walk
                name="walk_forward_40cm"
                distance="[0.15]"/>

            <!-- 7. 少しだけ左へ旋回する -->
            <!-- <TurnLeft
                name="turn_left_before_grab"
                turn_seconds="[0.50]"
                turn_speed="[0.20]"/> -->

            <!-- 8. グリッパーを閉じてキューブをつかむ -->
            <Close name="grab_cube"/>

            <!-- 9. つかみ終わるまで待つ -->
            <Sleep
                name="wait_after_grab"
                time="[2.0]"/>

            <!-- 10. アームを初期姿勢へ戻す -->
            <ArmHome name="arm_home"/>

            <!-- 11. つかんだキューブを置く場所まで移動する -->
            
            <SetDestinationByName name="set_init" destination="INIT"/>
            <GoToPose name="move_to_place_loc"/>
            <Walk
                name="walk_forward_20cm"
                distance="[0.20]"/>

            <!-- 12. 物を置く -->

            <Hirou_Pose name="hirou_pose"/>
            <Open name="hirou"/> 

            <!-- 13. アームを初期姿勢へ戻す -->

            <ArmHome name="arm_home"/> 
            <Close name="grab_cube"/>
            <SetDestinationByName name="set_init" destination="INIT"/>
            <GoToPose name="move_to_place_loc"/>
            

        </Sequence>
    </BehaviorTree>
</root>