<root>
    <BehaviorTree ID="cube_grab">
        <Sequence name="main">
            
            <!-- 0. 位置指定 -->

            <SetDestinationByName name="set_init" destination="C"/>

            <!-- 1. 低confidence候補も探索対象にする。接近許可は後段RGB-Dで判定 -->
            <SearchCube
                name="search_cube"
                threshold="[0.30]"/>

            <!-- 2. 候補を画像中央に合わせる。ここではまだ移動権限を与えない -->
            <TakeAim
                name="take_aim_before_approach"
                threshold="[0.30]"
                turn_speed="[0.15]"
                center_tolerance="[12.0]"/>

            <!-- 3. 低confidence候補をDepth + 57mm幾何 + 3/5 temporalで確認してから接近 -->
            <GoFrontCube
                name="go_front_cube"
                threshold="[0.30]"
                stop_distance="[0.30]"
                forward_speed="[0.15]"
                turn_speed="[0.15]"
                target_offset_px="[40]"
                pose_max_reprojection_error_px="[1.5]"
                use_pose_3d="[0]"
                depth_sample_count="[1]"
                depth_roi_fraction="[0.35]"
                depth_minimum_valid_ratio="[0.60]"
                depth_maximum_mad_m="[0.025]"
                depth_maximum_spread_m="[0.030]"
                cube_side_length_m="[0.057]"
                geometry_minimum_scale="[0.60]"
                geometry_maximum_scale="[1.90]"
                temporal_window_size="[5]"
                temporal_required_count="[3]"
                temporal_center_distance_px="[60]"/>
            <!-- 4. 接近済み・確認済みの同一候補を再び中央に合わせる -->
            <TakeAim
                name="take_aim_after_approach"
                threshold="[0.30]"
                turn_speed="[0.10]"
                center_tolerance="[10.0]"/>
  
            <!-- 5. アームを物をつかむ姿勢にする -->
            <Open name="hirou"/>  
            <Hirou_Pose name="hirou_pose"/>

            <!-- 6. 盲目前進を15cmに抑える -->
            <Walk
                name="walk_forward_15cm"
                distance="[0.15]"/>

            <!-- 7. 固定旋回はせず、その場でキューブをつかむ -->
            <Close name="grab_cube"/>

            <!-- 8. つかみ終わるまで待つ -->
            <Sleep
                name="wait_after_grab"
                time="[2.0]"/>

            <!-- 9. アームを初期姿勢へ戻す -->
            <ArmHome name="arm_home"/>

            <!-- 10. つかんだキューブを置く場所まで移動する -->
            
            <GoToPose name="go" />

            <!-- 11. 物を置く -->

            <Hirou_Pose name="hirou_pose"/>
            <Open name="hirou"/> 

            <!-- 12. アームを初期姿勢へ戻す -->

            <ArmHome name="arm_home"/> 
            <Close name="grab_cube"/>

            <!-- 13. 初期位置へ戻る -->

            <SetDestinationByName name="set_init" destination="INIT"/>
            <GoToPose name="move_to_place_loc"/>
            

        </Sequence>
    </BehaviorTree>
</root>
